# --- Required ---

# From @BotFather. This is the only variable the bot needs: every chat sends its
# own iCal link to the bot with /start, and links are stored per chat.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME

# --- Optional: pre-register one feed, for single-tenant deployments ---

# Set BOTH of these to register a link on startup without touching Telegram.
# Setting the URL alone only logs a warning - chats add their own links.
#
# The URL is the "all bookings" iCal export from NoBeds: Channels -> iCal Export.
# It is a bearer credential - anyone with it can read your booking data. Never
# commit the real value.
NOBEDS_ICAL_URL=
# Message your bot and run /chatid to find it, or use a group/channel id
# (groups are negative, e.g. -1001234567890).
TELEGRAM_CHAT_ID=

# --- Optional ---

# How often to poll every registered feed. Minimum 60s. NoBeds serves this URL
# to OTAs that poll every 1-5 minutes, so 300s is well within normal usage.
POLL_INTERVAL_SECONDS=300

# PERSISTENT store: the registered iCal links, and nothing else. No guest data
# ever lands here. This is the only file worth backing up.
DB_PATH=./data/feeds.db

# DISPOSABLE store: last-poll bookings, kept only so one poll can be diffed
# against the next (iCal is a state feed, so that is the only way "created /
# changed / cancelled" can exist). Under /tmp on purpose - guest names and
# addresses stay off the persistent volume, and a reboot wipes it. The cost of
# losing it is notifications for changes made while the bot was down.
SNAPSHOT_PATH=/tmp/nobeds-snapshot.db

# A newly registered feed is seeded silently, because otherwise you get one
# Telegram message per existing booking. Set true to announce them anyway.
NOTIFY_ON_FIRST_RUN=false

# Timezone and locale used to render dates, and to decide what "tonight" means.
DISPLAY_TIMEZONE=Europe/Vilnius
DISPLAY_LOCALE=en-GB

# Default window for /availability, in nights. Overridable per command.
AVAILABILITY_DAYS=14

# A booking that vanishes from the feed is only reported as cancelled if its
# checkout is within this many days of now. Protects against false "cancelled"
# alerts when old bookings simply age out of the export window.
CANCEL_GRACE_DAYS=2

# Alert after this many consecutive poll failures (network, 5xx, bad payload).
FAILURE_ALERT_THRESHOLD=3

# How many links one chat may register.
MAX_FEEDS_PER_CHAT=10

# Hosts a chat is allowed to register, comma separated. This is what stops an
# open bot being used to fetch arbitrary URLs. Subdomains are included.
ALLOWED_ICAL_HOSTS=nobeds.app,nobeds.com

# --- Deployment target, used by ./deploy.sh ---
# Kept here rather than in the script so the repository carries no hostname,
# no login, and no server paths. Both are required by deploy.sh.
DEPLOY_HOST=user@example.com
DEPLOY_DIR=/srv/nobeds-telegram
# Optional; defaults to /usr/local/bin/bun.
DEPLOY_BUN=/usr/local/bin/bun
